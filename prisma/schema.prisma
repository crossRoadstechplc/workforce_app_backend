generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
}

enum TokenType {
  REFRESH
}

enum AttendanceStatus {
  OPEN
  PRESENT_ON_TIME
  PRESENT_LATE
  COMPLETED_ON_TIME
  COMPLETED_LATE
  MISSING_CHECKOUT
}

enum AttendanceLocationType {
  CHECK_IN
  CHECK_OUT
}

enum WorksheetStatus {
  SUBMITTED
  REVIEWED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum LeaveDecisionType {
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationType {
  ACCOUNT_CREATED
  PASSWORD_CHANGED
  CHECK_IN_SUCCESS
  CHECK_IN_LATE
  CHECK_OUT_SUCCESS
  CHECKOUT_REMINDER
  MISSING_CHECKOUT
  LEAVE_SUBMITTED
  LEAVE_APPROVED
  LEAVE_REJECTED
  ATTENDANCE_CORRECTED
  WORKSHEET_REVIEWED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum InviteType {
  ORG_ADMIN
  OFFICE_ADMIN
  EMPLOYEE
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

model Organization {
  id          String                     @id @default(uuid()) @db.Uuid
  name        String
  slug        String                     @unique
  isActive    Boolean                    @default(true) @map("is_active")
  createdAt   DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships OrganizationMembership[]
  offices     Office[]
  schedules   WorkSchedule[]
  leaveTypes  LeaveType[]
  employees   Employee[]
  invites     Invite[]
  @@map("organizations")
}

model OrganizationMembership {
  userId         String       @map("user_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@id([userId, organizationId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model AdminOffice {
  userId    String   @map("user_id") @db.Uuid
  officeId  String   @map("office_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  @@id([userId, officeId])
  @@index([officeId])
  @@map("admin_offices")
}

model User {
  id                 String                     @id @default(uuid()) @db.Uuid
  email              String                     @unique
  passwordHash       String                     @map("password_hash")
  mustChangePassword Boolean                    @default(true) @map("must_change_password")
  status             UserStatus                 @default(ACTIVE)
  lastLoginAt        DateTime?                  @map("last_login_at") @db.Timestamptz(6)
  createdAt          DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee           Employee?
  userRoles          UserRole[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]                 @relation("AuditActor")
  leaveDecisions     LeaveDecision[]            @relation("LeaveDecisionAdmin")
  notifications      Notification[]
  devices            UserDevice[]
  reviewedWorksheets Worksheet[]                @relation("WorksheetReviewer")
  memberships        OrganizationMembership[]
  adminOffices       AdminOffice[]
  invites            Invite[]                   @relation("InviteUser")
  sentInvites        Invite[]                   @relation("InviteInviter")
  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  userRoles   UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Office {
  id                    String        @id @default(uuid()) @db.Uuid
  organizationId        String        @map("organization_id") @db.Uuid
  name                  String
  address               String?
  latitude              Decimal       @db.Decimal(10, 7)
  longitude             Decimal       @db.Decimal(10, 7)
  allowedRadiusMeters   Int           @map("allowed_radius_meters")
  maximumAccuracyMeters Int           @default(100) @map("maximum_accuracy_meters")
  timezone              String        @default("Africa/Addis_Ababa")
  isActive              Boolean       @default(true) @map("is_active")
  createdAt             DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees             Employee[]
  timesheets            Timesheet[]
  adminOffices          AdminOffice[]
  invites               Invite[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("offices")
}

model WorkSchedule {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  name             String
  /// Default / summary check-in (derived from first working day when days are set)
  checkInTime      String            @map("check_in_time")
  /// Default / summary check-out (derived from first working day when days are set)
  checkOutTime     String            @map("check_out_time")
  lateGraceMinutes Int               @default(0) @map("late_grace_minutes")
  /// Denormalized list of working weekdays (1=Mon … 7=Sun), derived from days
  workingDays      Int[]             @map("working_days")
  timezone         String            @default("Africa/Addis_Ababa")
  isActive         Boolean           @default(true) @map("is_active")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  days             WorkScheduleDay[]
  employees        Employee[]
  timesheets       Timesheet[]
  invites          Invite[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("work_schedules")
}

/// Per-weekday check-in / check-out for a work schedule (only working days are stored).
model WorkScheduleDay {
  id           String       @id @default(uuid()) @db.Uuid
  scheduleId   String       @map("schedule_id") @db.Uuid
  weekday      Int          // Luxon weekday: 1=Monday … 7=Sunday
  checkInTime  String       @map("check_in_time")
  checkOutTime String       @map("check_out_time")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  schedule     WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  @@unique([scheduleId, weekday])
  @@index([scheduleId])
  @@map("work_schedule_days")
}

model Employee {
  id                  String         @id @default(uuid()) @db.Uuid
  organizationId      String         @map("organization_id") @db.Uuid
  userId              String         @unique @map("user_id") @db.Uuid
  employeeCode        String         @map("employee_code")
  officeId            String?        @map("office_id") @db.Uuid
  scheduleId          String?        @map("schedule_id") @db.Uuid
  firstName           String         @map("first_name")
  middleName          String?        @map("middle_name")
  lastName            String         @map("last_name")
  phone               String?
  jobTitle            String?        @map("job_title")
  department          String?
  employmentStartDate DateTime       @map("employment_start_date") @db.Date
  status              EmployeeStatus @default(ACTIVE)
  createdAt           DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user                User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  office              Office?        @relation(fields: [officeId], references: [id], onDelete: SetNull)
  schedule            WorkSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  timesheets          Timesheet[]
  worksheets          Worksheet[]
  lateReasons         LateReason[]
  leaveRequests       LeaveRequest[]
  @@unique([organizationId, employeeCode])
  @@index([organizationId, status])
  @@index([officeId])
  @@index([scheduleId])
  @@index([status, officeId])
  @@map("employees")
}

model Invite {
  id              String       @id @default(uuid()) @db.Uuid
  type            InviteType
  status          InviteStatus @default(PENDING)
  email           String
  organizationId  String       @map("organization_id") @db.Uuid
  userId          String?      @map("user_id") @db.Uuid
  officeIds       String[]     @default([]) @map("office_ids")
  officeId        String?      @map("office_id") @db.Uuid
  scheduleId      String?      @map("schedule_id") @db.Uuid
  payload         Json?
  tokenHash       String       @unique @map("token_hash")
  expiresAt       DateTime     @map("expires_at") @db.Timestamptz(6)
  acceptedAt      DateTime?    @map("accepted_at") @db.Timestamptz(6)
  invitedByUserId String       @map("invited_by_user_id") @db.Uuid
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?        @relation("InviteUser", fields: [userId], references: [id], onDelete: SetNull)
  invitedBy       User         @relation("InviteInviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)
  office          Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  schedule        WorkSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  @@index([organizationId, status])
  @@index([email])
  @@index([userId])
  @@map("invites")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash")
  deviceId          String?   @map("device_id")
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  lastUsedAt        DateTime? @map("last_used_at") @db.Timestamptz(6)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id")
  oldValues   Json?    @map("old_values")
  newValues   Json?    @map("new_values")
  reason      String?
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  actor       User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model Timesheet {
  id                          String                  @id @default(uuid()) @db.Uuid
  employeeId                  String                  @map("employee_id") @db.Uuid
  officeId                    String                  @map("office_id") @db.Uuid
  scheduleId                  String                  @map("schedule_id") @db.Uuid
  workDate                    DateTime                @map("work_date") @db.Date
  scheduledCheckIn            DateTime                @map("scheduled_check_in") @db.Timestamptz(6)
  scheduledCheckOut           DateTime                @map("scheduled_check_out") @db.Timestamptz(6)
  actualCheckIn               DateTime                @map("actual_check_in") @db.Timestamptz(6)
  actualCheckOut              DateTime?               @map("actual_check_out") @db.Timestamptz(6)
  lateMinutes                 Int                     @default(0) @map("late_minutes")
  earlyCheckoutMinutes        Int                     @default(0) @map("early_checkout_minutes")
  workedMinutes               Int                     @default(0) @map("worked_minutes")
  overtimeMinutes             Int                     @default(0) @map("overtime_minutes")
  status                      AttendanceStatus        @default(OPEN)
  isOpen                      Boolean                 @default(true) @map("is_open")
  isLate                      Boolean                 @default(false) @map("is_late")
  isEarlyCheckout             Boolean                 @default(false) @map("is_early_checkout")
  isMissingCheckout           Boolean                 @default(false) @map("is_missing_checkout")
  checkInIdempotencyKey       String                  @unique @map("check_in_idempotency_key")
  checkOutIdempotencyKey      String?                 @unique @map("check_out_idempotency_key")
  scheduleCheckInTime         String                  @map("schedule_check_in_time")
  scheduleCheckOutTime        String                  @map("schedule_check_out_time")
  scheduleLateGraceMinutes    Int                     @map("schedule_late_grace_minutes")
  officeLatitude              Decimal                 @map("office_latitude") @db.Decimal(10, 7)
  officeLongitude             Decimal                 @map("office_longitude") @db.Decimal(10, 7)
  officeAllowedRadiusMeters   Int                     @map("office_allowed_radius_meters")
  officeMaximumAccuracyMeters Int                     @map("office_maximum_accuracy_meters")
  timezone                    String
  createdAt                   DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                   DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee                    Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  office                      Office                  @relation(fields: [officeId], references: [id], onDelete: Restrict)
  schedule                    WorkSchedule            @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  locations                   AttendanceLocation[]
  lateReason                  LateReason?
  worksheet                   Worksheet?
  corrections                 AttendanceCorrection[]
  @@unique([employeeId, workDate])
  @@index([employeeId, isOpen])
  @@index([workDate, status])
  @@index([officeId, workDate])
  @@index([employeeId, workDate, status])
  @@map("timesheets")
}

model AttendanceLocation {
  id                       String                 @id @default(uuid()) @db.Uuid
  timesheetId              String                 @map("timesheet_id") @db.Uuid
  type                     AttendanceLocationType
  latitude                 Decimal                @db.Decimal(10, 7)
  longitude                Decimal                @db.Decimal(10, 7)
  accuracyMeters           Decimal                @map("accuracy_meters") @db.Decimal(8, 2)
  distanceFromOfficeMeters Decimal                @map("distance_from_office_meters") @db.Decimal(10, 2)
  allowedRadiusMeters      Int                    @map("allowed_radius_meters")
  isInsideRadius           Boolean                @map("is_inside_radius")
  capturedAt               DateTime               @map("captured_at") @db.Timestamptz(6)
  serverReceivedAt         DateTime               @map("server_received_at") @db.Timestamptz(6)
  photoUrl                 String?                @map("photo_url")
  createdAt                DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  timesheet                Timesheet              @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  @@index([timesheetId, type])
  @@map("attendance_locations")
}

model LateReason {
  id                String    @id @default(uuid()) @db.Uuid
  timesheetId       String    @unique @map("timesheet_id") @db.Uuid
  employeeId        String    @map("employee_id") @db.Uuid
  reasonType        String    @map("reason_type")
  reasonDescription String?   @map("reason_description")
  submittedAt       DateTime  @map("submitted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  timesheet         Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  @@index([employeeId, submittedAt])
  @@map("late_reasons")
}

model Worksheet {
  id              String          @id @default(uuid()) @db.Uuid
  timesheetId     String          @unique @map("timesheet_id") @db.Uuid
  employeeId      String          @map("employee_id") @db.Uuid
  workDate        DateTime        @map("work_date") @db.Date
  workDescription String          @map("work_description")
  status          WorksheetStatus @default(SUBMITTED)
  submittedAt     DateTime        @map("submitted_at") @db.Timestamptz(6)
  reviewedBy      String?         @map("reviewed_by") @db.Uuid
  reviewedAt      DateTime?       @map("reviewed_at") @db.Timestamptz(6)
  adminComment    String?         @map("admin_comment")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  timesheet       Timesheet       @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  employee        Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  reviewer        User?           @relation("WorksheetReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  @@index([employeeId, workDate])
  @@index([workDate, status])
  @@map("worksheets")
}

model AttendanceCorrection {
  id              String    @id @default(uuid()) @db.Uuid
  timesheetId     String    @map("timesheet_id") @db.Uuid
  actorUserId     String    @map("actor_user_id") @db.Uuid
  reason          String
  previousValues  Json      @map("previous_values")
  correctedValues Json      @map("corrected_values")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  timesheet       Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  @@index([timesheetId, createdAt])
  @@map("attendance_corrections")
}

model LeaveType {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  name           String
  description    String?
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requests       LeaveRequest[]
  @@unique([organizationId, name])
  @@index([organizationId, isActive])
  @@map("leave_types")
}

model LeaveRequest {
  id           String          @id @default(uuid()) @db.Uuid
  employeeId   String          @map("employee_id") @db.Uuid
  leaveTypeId  String          @map("leave_type_id") @db.Uuid
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime        @map("end_date") @db.Date
  numberOfDays Decimal         @map("number_of_days") @db.Decimal(6, 2)
  reason       String
  status       LeaveStatus     @default(PENDING)
  requestedAt  DateTime        @default(now()) @map("requested_at") @db.Timestamptz(6)
  updatedAt    DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  employee     Employee        @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveType    LeaveType       @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  decisions    LeaveDecision[]
  @@index([employeeId, status, startDate])
  @@index([status, requestedAt])
  @@index([startDate, endDate, status])
  @@map("leave_requests")
}

model LeaveDecision {
  id             String            @id @default(uuid()) @db.Uuid
  leaveRequestId String            @map("leave_request_id") @db.Uuid
  adminUserId    String            @map("admin_user_id") @db.Uuid
  decision       LeaveDecisionType
  decisionReason String?           @map("decision_reason")
  decidedAt      DateTime          @default(now()) @map("decided_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  leaveRequest   LeaveRequest      @relation(fields: [leaveRequestId], references: [id], onDelete: Restrict)
  admin          User              @relation("LeaveDecisionAdmin", fields: [adminUserId], references: [id], onDelete: Restrict)
  @@index([leaveRequestId, decidedAt])
  @@map("leave_decisions")
}

model Notification {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  type              NotificationType
  title             String
  message           String
  relatedEntityType String?          @map("related_entity_type")
  relatedEntityId   String?          @map("related_entity_id")
  isRead            Boolean          @default(false) @map("is_read")
  readAt            DateTime?        @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

model UserDevice {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  deviceId   String         @map("device_id")
  fcmToken   String         @map("fcm_token")
  platform   DevicePlatform
  appVersion String?        @map("app_version")
  isActive   Boolean        @default(true) @map("is_active")
  lastSeenAt DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, deviceId])
  @@index([userId, isActive])
  @@map("user_devices")
}
