{
  "name": "workforce-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "job:missing-checkouts": "tsx src/jobs/missing-checkouts.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.44.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "firebase-admin": "^13.4.0",
    "helmet": "^8.1.0",
    "jose": "^6.2.0",
    "luxon": "^3.7.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.22.0",
    "pino": "^9.7.0",
    "pino-http": "^10.5.0",
    "prisma": "^7.0.0",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/luxon": "^3.7.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.4",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
