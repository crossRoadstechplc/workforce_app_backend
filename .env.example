NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://workforce:workforce@localhost:5432/workforce?schema=public
CORS_ORIGINS=*
JWT_ISSUER=workforce-api
JWT_AUDIENCE=workforce-clients
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-at-least-32-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=ChangeMe123!

# Demo fixture seed (set false in production)
SEED_DEMO_DATA=true
SEED_DEMO_PASSWORD=Demo123!

# Optional Firebase Cloud Messaging
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudinary — attendance check-in / check-out verification photos
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=workforce/attendance
ATTENDANCE_PHOTO_REQUIRED=true

MISSING_CHECKOUT_GRACE_MINUTES=120

# Optional SMTP for invite emails (leave blank until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Workforce <noreply@localhost>
# Must be a public https URL in production. Invite emails use this as the button link.
# Example: https://admin.yourdomain.com
ADMIN_PORTAL_URL=http://localhost:3000
INVITE_TTL_HOURS=72

# Local/dev only: skip office radius + accuracy checks so Chrome/emulator check-in works.
# Set to false when you want to test real geofencing locally. Ignored when NODE_ENV=production.
ATTENDANCE_DEV_BYPASS_GEOFENCE=true
